generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Visit {
  id        String   @id @default(cuid())
  source    String
  path      String
  browser   String
  os        String
  device    String
  ip        String?
  createdAt DateTime @default(now())
}
